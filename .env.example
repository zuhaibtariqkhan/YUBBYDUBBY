# WooCommerce REST API Settings
NEXT_PUBLIC_WOOCOMMERCE_URL=https://shop.yubbydubby.com
WOOCOMMERCE_CONSUMER_KEY=your_woocommerce_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=your_woocommerce_consumer_secret_here

# Email SMTP Settings (for OTP & Notification Emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@yubbydubby.com
SMTP_PASS=your_smtp_password_here

# Auth JWT Secret Key (for Stateless OTP & Token Signing)
COCART_JWT_AUTH_SECRET_KEY=your_jwt_secret_key_here

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
